{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Rzvation Hilfe",
  "description": "Anleitungen und Hilfe zu Rzvation – Events, Objekte und Buchungen einfach verwalten.",
  "colors": {
    "primary": "#2b6cb0",
    "light": "#5b9bd5",
    "dark": "#1e4d8c"
  },
  "favicon": "/images/favicon.png",
  "navigation": {
    "languages": [
      {
        "language": "de",
        "groups": [
          {
            "group": "Erste Schritte",
            "expanded": true,
            "pages": [
              "einfuehrung",
              "konto-erstellen",
              "schnellstart",
              "uebersicht"
            ]
          },
          {
            "group": "Angebote",
            "pages": [
              "events",
              "objekte",
              "buchungsseite",
              "so-buchen-ihre-gaeste"
            ]
          },
          {
            "group": "Rund um Ihre Angebote",
            "pages": [
              "e-mail-texte",
              "eintrittskarten-gestalten",
              "einlass-scanner"
            ]
          },
          {
            "group": "Buchungen",
            "pages": [
              "buchungen"
            ]
          },
          {
            "group": "Mitglieder",
            "pages": [
              "mitglieder",
              "importieren"
            ]
          },
          {
            "group": "Einstellungen",
            "pages": [
              "mein-konto",
              "anbieterdaten",
              "zahlungen",
              "benutzer",
              "abonnement",
              "av-vertrag"
            ]
          },
          {
            "group": "Nachschlagen",
            "pages": [
              "stichwortverzeichnis"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/organisation",
      "destination": "/anbieterdaten"
    },
    {
      "source": "/basisdaten",
      "destination": "/anbieterdaten"
    },
    {
      "source": "/kontakt",
      "destination": "/anbieterdaten"
    },
    {
      "source": "/einstellungen",
      "destination": "/anbieterdaten"
    },
    {
      "source": "/buchungsseiten",
      "destination": "/buchungsseite"
    },
    {
      "source": "/buchungsseiten-erstellen-bearbeiten",
      "destination": "/buchungsseite"
    },
    {
      "source": "/ressourcen",
      "destination": "/objekte"
    },
    {
      "source": "/kategorien",
      "destination": "/objekte"
    },
    {
      "source": "/verfuegbarkeit",
      "destination": "/objekte"
    },
    {
      "source": "/objekt-anlegen-bearbeiten",
      "destination": "/objekte"
    },
    {
      "source": "/veranstaltungen",
      "destination": "/events"
    },
    {
      "source": "/veranstaltung-anlegen",
      "destination": "/events"
    },
    {
      "source": "/reservierungen",
      "destination": "/buchungen"
    },
    {
      "source": "/reservierungen-verwalten",
      "destination": "/buchungen"
    },
    {
      "source": "/zahlungsuebersicht",
      "destination": "/buchungen"
    },
    {
      "source": "/rollen-berechtigungen",
      "destination": "/benutzer"
    },
    {
      "source": "/persoenliche-einstellungen",
      "destination": "/mein-konto"
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.rzvation.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@rzvation.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Zur Anmeldung",
      "href": "https://www.rzvation.com/login"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Rzvation",
        "items": [
          {
            "label": "Startseite",
            "href": "https://www.rzvation.com"
          },
          {
            "label": "Impressum",
            "href": "https://www.rzvation.com/impressum"
          },
          {
            "label": "Datenschutz",
            "href": "https://www.rzvation.com/datenschutz"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Suchen, z. B. „Mitgliederpreis“ oder „Buchung stornieren“ …"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  }
}

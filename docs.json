{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Rzvation Hilfe",
  "description": "Anleitungen und Hilfe zu Rzvation – Reservierungen, Verfügbarkeiten und Veranstaltungen einfach verwalten.",
  "colors": {
    "primary": "#2b6cb0",
    "light": "#5b9bd5",
    "dark": "#1e4d8c"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "de",
        "groups": [
          {
            "group": "Erste Schritte",
            "expanded": true,
            "pages": [
              "einfuehrung",
              "konto-erstellen",
              "schnellstart",
              "uebersicht",
              "stichwortverzeichnis"
            ]
          },
          {
            "group": "Grundkonzepte",
            "pages": [
              "organisation",
              "buchungsseiten",
              "ressourcen",
              "veranstaltungen",
              "reservierungen"
            ]
          },
          {
            "group": "Organisation",
            "pages": [
              "basisdaten",
              "kontakt",
              "buchungsseiten-erstellen-bearbeiten",
              "einstellungen",
              "zahlungen",
              "abonnement",
              "av-vertrag"
            ]
          },
          {
            "group": "Benutzerverwaltung",
            "pages": [
              "rollen-berechtigungen",
              "benutzer",
              "persoenliche-einstellungen"
            ]
          },
          {
            "group": "Ressourcen (Objekte)",
            "pages": [
              "verfuegbarkeit",
              "kategorien",
              "objekt-anlegen-bearbeiten"
            ]
          },
          {
            "group": "Veranstaltungen",
            "pages": [
              "veranstaltung-anlegen",
              "eintrittskarten-gestalten",
              "einlass-scanner"
            ]
          },
          {
            "group": "Mitglieder / Personen",
            "pages": [
              "mitglieder",
              "importieren"
            ]
          },
          {
            "group": "Reservierungen",
            "pages": [
              "reservierungen-verwalten",
              "zahlungsuebersicht"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.rzvation.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@rzvation.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Zur Anmeldung",
      "href": "https://www.rzvation.com/login"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Rzvation",
        "items": [
          {
            "label": "Startseite",
            "href": "https://www.rzvation.com"
          },
          {
            "label": "Impressum",
            "href": "https://www.rzvation.com/impressum"
          },
          {
            "label": "Datenschutz",
            "href": "https://www.rzvation.com/datenschutz"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Suchen, z. B. „Mitgliederpreis“ oder „Buchung stornieren“ …"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  }
}
